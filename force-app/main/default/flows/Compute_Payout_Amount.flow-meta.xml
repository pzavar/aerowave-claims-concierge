    <assignments>
        <name>Set_Payout_Cancellation</name>
        <label>Set Payout Cancellation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varPayoutAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>300.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPayoutReason</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Flight canceled</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Set_Payout_Output</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Payout_Delay_Eligible</name>
        <label>Set Payout Delay Eligible</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varPayoutAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>150.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPayoutReason</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Delay of 120+ minutes</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Set_Payout_Output</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Payout_Delay_Not_Eligible</name>
        <label>Set Payout Delay Not Eligible</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varPayoutAmount</assignToReference>
            <operator>Assign</operator>
            <value>
