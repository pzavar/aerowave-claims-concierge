    <recordLookups>
        <name>Get_Flight_Status_Record</name>
        <label>Get Flight Status Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Determine_Payout</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>FlightNumber__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>FlightNumber</elementReference>
            </value>
        </filters>
        <filters>
            <field>Date__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>frmlDateFromText</elementReference>
            </value>
        </filters>
        <object>Flight_Status_Events__dlm</object>
        <outputAssignments>
            <assignToReference>varDelayMinutesRaw</assignToReference>
            <field>DelayMinutes__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varFlightStatusRaw</assignToReference>
            <field>Status__c</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Get_Policy_Record</name>
        <label>Get Policy Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Flight_Status_Record</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>BookingID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>BookingID</elementReference>
            </value>
        </filters>
        <object>Policies__dlm</object>
        <outputAssignments>
            <assignToReference>varPolicyIdRaw</assignToReference>
            <field>PolicyID__c</field>
        </outputAssignments>
    </recordLookups>
