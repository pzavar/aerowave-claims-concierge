        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPayoutReason</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No flight status record found</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Set_Payout_Output</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Payout_On_Time</name>
        <label>Set Payout On Time</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varPayoutAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPayoutReason</assignToReference>
            <operator>Assign</operator>
            <value>
