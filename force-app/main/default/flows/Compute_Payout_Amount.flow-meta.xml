        </connector>
    </assignments>
    <assignments>
        <name>Set_Payout_Output</name>
        <label>Set Payout Output</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>PayoutAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varPayoutAmount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>PayoutReason</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varPayoutReason</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>FlightStatus</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varFlightStatusRaw</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>DelayMinutes</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varDelayMinutesRaw</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>PolicyID</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varPolicyIdRaw</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Determine_Payout</name>
        <label>Determine Payout</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Payout_Not_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Flight Status record found</defaultConnectorLabel>
        <rules>
            <name>Cancellation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varFlightStatusRaw</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Canceled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Payout_Cancellation</targetReference>
            </connector>
            <label>Cancelation</label>
        </rules>
        <rules>
            <name>DelayEligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varFlightStatusRaw</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Delayed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varDelayMinutesRaw</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>120.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Payout_Delay_Eligible</targetReference>
            </connector>
            <label>DelayEligible</label>
        </rules>
        <rules>
            <name>DelayNotEligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varFlightStatusRaw</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Delayed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varDelayMinutesRaw</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>120.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Payout_Delay_Not_Eligible</targetReference>
            </connector>
            <label>DelayNotEligible</label>
        </rules>
        <rules>
            <name>OnTime</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varFlightStatusRaw</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>OnTime</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Payout_On_Time</targetReference>
            </connector>
            <label>OnTime</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>frmlDateFromText</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!DateText})</expression>
    </formulas>
    <interviewLabel>ComputePayoutAmount {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ComputePayoutAmount</label>
    <processMetadataValues>
        <name>BuilderType</name>
