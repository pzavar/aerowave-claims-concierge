<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Booking_ID</name>
        <label>Add Booking ID</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varBookingIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Through_Policies.BookingID__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Policies</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Email_Path_Results</name>
        <label>Set Email Path Results</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>RecordCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Claims_By_Booking_IDs</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ClaimSummary</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frmlEmailClaimSummary</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_No_Reference_Result</name>
        <label>Set No Reference Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>RecordCount</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ClaimSummary</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No email or booking/claim reference was provided. Please provide one so I can look up your claim.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Reference_Path_Results</name>
        <label>Set Reference Path Results</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>RecordCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Claims_By_Reference</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ClaimSummary</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frmlRefClaimSummary</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Email_Provided</name>
        <label>Email Provided?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Claims_By_Reference</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Email_Path</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Policy_By_Email</targetReference>
            </connector>
            <label>Email Path</label>
        </rules>
    </decisions>
    <decisions>
        <name>Reference_Provided</name>
        <label>Reference Provided?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_No_Reference_Result</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Has_Reference</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>BookingOrClaimReference</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_Provided</targetReference>
            </connector>
            <label>Has Reference</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>frmlEmailClaimSummary</name>
        <dataType>String</dataType>
        <expression>IF({!RecordCount} = 0,
   &quot;No claims found for this email.&quot;,
   TEXT({!RecordCount}) &amp; &quot; claim(s) found for this email.&quot;)</expression>
    </formulas>
    <formulas>
        <name>frmlEmailLower</name>
        <dataType>String</dataType>
        <expression>LOWER({!Email})</expression>
    </formulas>
    <formulas>
        <name>frmlRefClaimSummary</name>
        <dataType>String</dataType>
        <expression>IF({!RecordCount} = 0,
&quot;No claims found for this booking or claim reference.&quot;,
TEXT({!RecordCount}) &amp; &quot; claim(s) found for this booking or claim reference.&quot;)</expression>
    </formulas>
    <interviewLabel>Query Disruption Claims {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Query Disruption Claims</label>
    <loops>
        <name>Loop_Through_Policies</name>
        <label>Loop Through Policies</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Policy_By_Email</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Booking_ID</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Claims_By_Booking_IDs</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Claims_By_Booking_IDs</name>
        <label>Get Claims By Booking IDs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Email_Path_Results</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>BookingID__c</field>
            <operator>In</operator>
            <value>
                <elementReference>varBookingIds</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Claims__dlm</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Claims_By_Reference</name>
        <label>Get Claims By Reference</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Reference_Path_Results</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>BookingID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>BookingOrClaimReference</elementReference>
            </value>
        </filters>
        <filters>
            <field>ClaimID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>BookingOrClaimReference</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Claims__dlm</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Policy_By_Email</name>
        <label>Get Policy By Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_Policies</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PolicyHolderEmail__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>frmlEmailLower</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Policies__dlm</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Reference_Provided</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>BookingOrClaimReference</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>A formatted, human-readable summary.</description>
        <name>ClaimSummary</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>Email</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>RecordCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>varBookingIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
